<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app dlopens the user-installed PCAN driver (libPCBUSB.dylib),
	     which isn't signed by our team. Hardened runtime library validation
	     would refuse to load it, so no PCAN devices would show up. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
